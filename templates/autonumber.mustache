{{!
    @template datafield_autonumber/autonumber

    Settings of the entry number field.

    Example context (json):
    {
        "name": "Request number",
        "description": "Given automatically",
        "param1": "REQ-",
        "param2": "4"
    }
}}
<fieldset>
    {{> mod_data/fields/basicfields }}
    <div class="row mb-2 fitem">
        <label for="param1" class="col-md-3 col-form-label">{{#str}}prefix, datafield_autonumber{{/str}}</label>
        <div class="col-md-9 felement">
            <input class="form-control" type="text" name="param1" id="param1" maxlength="20" value="{{param1}}">
            <div class="form-text text-muted">{{#str}}prefix_help, datafield_autonumber{{/str}}</div>
        </div>
    </div>
    <div class="row mb-2 fitem">
        <label for="param2" class="col-md-3 col-form-label">{{#str}}digits, datafield_autonumber{{/str}}</label>
        <div class="col-md-9 felement">
            <input class="form-control" type="number" min="0" max="9" name="param2" id="param2" value="{{#param2}}{{param2}}{{/param2}}{{^param2}}4{{/param2}}">
            <div class="form-text text-muted">{{#str}}digits_help, datafield_autonumber{{/str}}</div>
        </div>
    </div>
    <p class="text-muted">{{#str}}numbering, datafield_autonumber{{/str}}</p>
</fieldset>
